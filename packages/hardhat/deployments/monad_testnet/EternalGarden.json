  "metadata": "{\"compiler\":{\"version\":\"0.8.28+commit.7893614a\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[{\"internalType\":\"uint64\",\"name\":\"inactivityWindow_\",\"type\":\"uint64\"}],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"},{\"inputs\":[],\"name\":\"EmptyCipherHash\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"GardenAlreadyExists\",\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"deadline\",\"type\":\"uint256\"}],\"name\":\"GardenExpired\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"GardenNotGrowing\",\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"deadline\",\"type\":\"uint256\"}],\"name\":\"GardenStillAlive\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"InvalidInactivityWindow\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"InvalidOwner\",\"type\":\"error\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"owner\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"witness\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"uint64\",\"name\":\"sealedAt\",\"type\":\"uint64\"}],\"name\":\"GardenEternallySealed\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"owner\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"bytes32\",\"name\":\"cipherHash\",\"type\":\"bytes32\"},{\"indexed\":false,\"internalType\":\"bytes32\",\"name\":\"publicMetaHash\",\"type\":\"bytes32\"},{\"indexed\":false,\"internalType\":\"uint64\",\"name\":\"plantedAt\",\"type\":\"uint64\"}],\"name\":\"GardenPlanted\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"owner\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"uint32\",\"name\":\"count\",\"type\":\"uint32\"},{\"indexed\":false,\"internalType\":\"uint64\",\"name\":\"timestamp\",\"type\":\"uint64\"}],\"name\":\"Heartbeat\",\"type\":\"event\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"owner\",\"type\":\"address\"}],\"name\":\"canSeal\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"owner\",\"type\":\"address\"}],\"name\":\"deadlineOf\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"owner\",\"type\":\"address\"}],\"name\":\"gardenOf\",\"outputs\":[{\"components\":[{\"internalType\":\"bytes32\",\"name\":\"cipherHash\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"publicMetaHash\",\"type\":\"bytes32\"},{\"internalType\":\"uint64\",\"name\":\"plantedAt\",\"type\":\"uint64\"},{\"internalType\":\"uint64\",\"name\":\"lastHeartbeat\",\"type\":\"uint64\"},{\"internalType\":\"uint64\",\"name\":\"sealedAt\",\"type\":\"uint64\"},{\"internalType\":\"uint32\",\"name\":\"heartbeatCount\",\"type\":\"uint32\"},{\"internalType\":\"enum EternalGarden.GardenState\",\"name\":\"state\",\"type\":\"uint8\"}],\"internalType\":\"struct EternalGarden.Garden\",\"name\":\"\",\"type\":\"tuple\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"heartbeat\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"inactivityWindow\",\"outputs\":[{\"internalType\":\"uint64\",\"name\":\"\",\"type\":\"uint64\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"cipherHash\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"publicMetaHash\",\"type\":\"bytes32\"}],\"name\":\"plant\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"owner\",\"type\":\"address\"}],\"name\":\"sealEternally\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"Plaintext, ciphertext and encryption keys must never be supplied to this contract.\",\"kind\":\"dev\",\"methods\":{},\"title\":\"Eternal Garden\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"notice\":\"Stores only encrypted-content commitments and an irreversible heartbeat state machine.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"project/contracts/EternalGarden.sol\":\"EternalGarden\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\",\"useLiteralContent\":true},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[]},\"sources\":{\"project/contracts/EternalGarden.sol\":{\"content\":\"// SPDX-License-Identifier: MIT\\r\\npragma solidity ^0.8.28;\\r\\n\\r\\n/// @title Eternal Garden\\r\\n/// @notice Stores only encrypted-content commitments and an irreversible heartbeat state machine.\\r\\n/// @dev Plaintext, ciphertext and encryption keys must never be supplied to this contract.\\r\\ncontract EternalGarden {\\r\\n    enum GardenState {\\r\\n        NONE,\\r\\n        GROWING,\\r\\n        ETERNAL\\r\\n    }\\r\\n\\r\\n    struct Garden {\\r\\n        bytes32 cipherHash;\\r\\n        bytes32 publicMetaHash;\\r\\n        uint64 plantedAt;\\r\\n        uint64 lastHeartbeat;\\r\\n        uint64 sealedAt;\\r\\n        uint32 heartbeatCount;\\r\\n        GardenState state;\\r\\n    }\\r\\n\\r\\n    error InvalidInactivityWindow();\\r\\n    error InvalidOwner();\\r\\n    error EmptyCipherHash();\\r\\n    error GardenAlreadyExists();\\r\\n    error GardenNotGrowing();\\r\\n    error GardenExpired(uint256 deadline);\\r\\n    error GardenStillAlive(uint256 deadline);\\r\\n\\r\\n    event GardenPlanted(\\r\\n        address indexed owner, bytes32 indexed cipherHash, bytes32 publicMetaHash, uint64 plantedAt\\r\\n    );\\r\\n    event Heartbeat(address indexed owner, uint32 count, uint64 timestamp);\\r\\n    event GardenEternallySealed(address indexed owner, address indexed witness, uint64 sealedAt);\\r\\n\\r\\n    uint64 public immutable inactivityWindow;\\r\\n\\r\\n    mapping(address owner => Garden garden) private gardens;\\r\\n\\r\\n    constructor(uint64 inactivityWindow_) {\\r\\n        if (inactivityWindow_ == 0) revert InvalidInactivityWindow();\\r\\n        inactivityWindow = inactivityWindow_;\\r\\n    }\\r\\n\\r\\n    function plant(bytes32 cipherHash, bytes32 publicMetaHash) external {\\r\\n        if (cipherHash == bytes32(0)) revert EmptyCipherHash();\\r\\n\\r\\n        Garden storage garden = gardens[msg.sender];\\r\\n        if (garden.state != GardenState.NONE) revert GardenAlreadyExists();\\r\\n\\r\\n        uint64 timestamp = uint64(block.timestamp);\\r\\n        garden.cipherHash = cipherHash;\\r\\n        garden.publicMetaHash = publicMetaHash;\\r\\n        garden.plantedAt = timestamp;\\r\\n        garden.lastHeartbeat = timestamp;\\r\\n        garden.heartbeatCount = 1;\\r\\n        garden.state = GardenState.GROWING;\\r\\n\\r\\n        emit GardenPlanted(msg.sender, cipherHash, publicMetaHash, timestamp);\\r\\n        emit Heartbeat(msg.sender, 1, timestamp);\\r\\n    }\\r\\n\\r\\n    function heartbeat() external {\\r\\n        Garden storage garden = gardens[msg.sender];\\r\\n        if (garden.state != GardenState.GROWING) revert GardenNotGrowing();\\r\\n\\r\\n        uint256 deadline = uint256(garden.lastHeartbeat) + inactivityWindow;\\r\\n        if (block.timestamp > deadline) revert GardenExpired(deadline);\\r\\n\\r\\n        uint64 timestamp = uint64(block.timestamp);\\r\\n        garden.heartbeatCount += 1;\\r\\n        garden.lastHeartbeat = timestamp;\\r\\n\\r\\n        emit Heartbeat(msg.sender, garden.heartbeatCount, timestamp);\\r\\n    }\\r\\n\\r\\n    function sealEternally(address owner) external {\\r\\n        if (owner == address(0)) revert InvalidOwner();\\r\\n\\r\\n        Garden storage garden = gardens[owner];\\r\\n        if (garden.state != GardenState.GROWING) revert GardenNotGrowing();\\r\\n\\r\\n        uint256 deadline = uint256(garden.lastHeartbeat) + inactivityWindow;\\r\\n        if (block.timestamp <= deadline) revert GardenStillAlive(deadline);\\r\\n\\r\\n        uint64 timestamp = uint64(block.timestamp);\\r\\n        garden.sealedAt = timestamp;\\r\\n        garden.state = GardenState.ETERNAL;\\r\\n\\r\\n        emit GardenEternallySealed(owner, msg.sender, timestamp);\\r\\n    }\\r\\n\\r\\n    function gardenOf(address owner) external view returns (Garden memory) {\\r\\n        return gardens[owner];\\r\\n    }\\r\\n\\r\\n    function deadlineOf(address owner) public view returns (uint256) {\\r\\n        Garden storage garden = gardens[owner];\\r\\n        if (garden.state == GardenState.NONE) return 0;\\r\\n        return uint256(garden.lastHeartbeat) + inactivityWindow;\\r\\n    }\\r\\n\\r\\n    function canSeal(address owner) external view returns (bool) {\\r\\n        Garden storage garden = gardens[owner];\\r\\n        return garden.state == GardenState.GROWING\\r\\n            && block.timestamp > uint256(garden.lastHeartbeat) + inactivityWindow;\\r\\n    }\\r\\n}\\r\\n\",\"keccak256\":\"0x4c3ea17a9959d0303e5704a6dd2ece1381700015a7dd82a8c1e805ddfc916e9c\",\"license\":\"MIT\"}},\"version\":1}",
