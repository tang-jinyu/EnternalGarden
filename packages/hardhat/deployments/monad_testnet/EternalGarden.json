  "metadata": "{\"compiler\":{\"version\":\"0.8.28+commit.7893614a\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[{\"internalType\":\"uint64\",\"name\":\"inactivityWindow_\",\"type\":\"uint64\"}],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"},{\"inputs\":[],\"name\":\"EmptyCipherHash\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"GardenAlreadyExists\",\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"deadline\",\"type\":\"uint256\"}],\"name\":\"GardenExpired\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"GardenNotGrowing\",\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"deadline\",\"type\":\"uint256\"}],\"name\":\"GardenStillAlive\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"InvalidInactivityWindow\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"InvalidOwner\",\"type\":\"error\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"owner\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"witness\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"uint64\",\"name\":\"sealedAt\",\"type\":\"uint64\"}],\"name\":\"GardenEternallySealed\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"owner\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"bytes32\",\"name\":\"cipherHash\",\"type\":\"bytes32\"},{\"indexed\":false,\"internalType\":\"bytes32\",\"name\":\"publicMetaHash\",\"type\":\"bytes32\"},{\"indexed\":false,\"internalType\":\"uint64\",\"name\":\"plantedAt\",\"type\":\"uint64\"}],\"name\":\"GardenPlanted\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"owner\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"uint32\",\"name\":\"count\",\"type\":\"uint32\"},{\"indexed\":false,\"internalType\":\"uint64\",\"name\":\"timestamp\",\"type\":\"uint64\"}],\"name\":\"Heartbeat\",\"type\":\"event\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"owner\",\"type\":\"address\"}],\"name\":\"canSeal\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"owner\",\"type\":\"address\"}],\"name\":\"deadlineOf\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"owner\",\"type\":\"address\"}],\"name\":\"gardenOf\",\"outputs\":[{\"components\":[{\"internalType\":\"bytes32\",\"name\":\"cipherHash\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"publicMetaHash\",\"type\":\"bytes32\"},{\"internalType\":\"uint64\",\"name\":\"plantedAt\",\"type\":\"uint64\"},{\"internalType\":\"uint64\",\"name\":\"lastHeartbeat\",\"type\":\"uint64\"},{\"internalType\":\"uint64\",\"name\":\"sealedAt\",\"type\":\"uint64\"},{\"internalType\":\"uint32\",\"name\":\"heartbeatCount\",\"type\":\"uint32\"},{\"internalType\":\"enum EternalGarden.GardenState\",\"name\":\"state\",\"type\":\"uint8\"}],\"internalType\":\"struct EternalGarden.Garden\",\"name\":\"\",\"type\":\"tuple\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"heartbeat\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"inactivityWindow\",\"outputs\":[{\"internalType\":\"uint64\",\"name\":\"\",\"type\":\"uint64\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"cipherHash\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"publicMetaHash\",\"type\":\"bytes32\"}],\"name\":\"plant\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"owner\",\"type\":\"address\"}],\"name\":\"sealEternally\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"Plaintext, ciphertext and encryption keys must never be supplied to this contract.\",\"kind\":\"dev\",\"methods\":{},\"title\":\"Eternal Garden\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"notice\":\"Stores only encrypted-content commitments and an irreversible heartbeat state machine.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"project/contracts/EternalGarden.sol\":\"EternalGarden\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\",\"useLiteralContent\":true},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[]},\"sources\":{\"project/contracts/EternalGarden.sol\":{\"content\":\"// SPDX-License-Identifier: MIT\\npragma solidity ^0.8.28;\\n\\n/// @title Eternal Garden\\n/// @notice Stores only encrypted-content commitments and an irreversible heartbeat state machine.\\n/// @dev Plaintext, ciphertext and encryption keys must never be supplied to this contract.\\ncontract EternalGarden {\\n    enum GardenState {\\n        NONE,\\n        GROWING,\\n        ETERNAL\\n    }\\n\\n    struct Garden {\\n        bytes32 cipherHash;\\n        bytes32 publicMetaHash;\\n        uint64 plantedAt;\\n        uint64 lastHeartbeat;\\n        uint64 sealedAt;\\n        uint32 heartbeatCount;\\n        GardenState state;\\n    }\\n\\n    error InvalidInactivityWindow();\\n    error InvalidOwner();\\n    error EmptyCipherHash();\\n    error GardenAlreadyExists();\\n    error GardenNotGrowing();\\n    error GardenExpired(uint256 deadline);\\n    error GardenStillAlive(uint256 deadline);\\n\\n    event GardenPlanted(address indexed owner, bytes32 indexed cipherHash, bytes32 publicMetaHash, uint64 plantedAt);\\n    event Heartbeat(address indexed owner, uint32 count, uint64 timestamp);\\n    event GardenEternallySealed(address indexed owner, address indexed witness, uint64 sealedAt);\\n\\n    uint64 public immutable inactivityWindow;\\n\\n    mapping(address owner => Garden garden) private gardens;\\n\\n    constructor(uint64 inactivityWindow_) {\\n        if (inactivityWindow_ == 0) revert InvalidInactivityWindow();\\n        inactivityWindow = inactivityWindow_;\\n    }\\n\\n    function plant(bytes32 cipherHash, bytes32 publicMetaHash) external {\\n        if (cipherHash == bytes32(0)) revert EmptyCipherHash();\\n\\n        Garden storage garden = gardens[msg.sender];\\n        if (garden.state == GardenState.GROWING) revert GardenAlreadyExists();\\n\\n        uint64 timestamp = uint64(block.timestamp);\\n        gardens[msg.sender] = Garden({\\n            cipherHash: cipherHash,\\n            publicMetaHash: publicMetaHash,\\n            plantedAt: timestamp,\\n            lastHeartbeat: timestamp,\\n            sealedAt: 0,\\n            heartbeatCount: 1,\\n            state: GardenState.GROWING\\n        });\\n\\n        emit GardenPlanted(msg.sender, cipherHash, publicMetaHash, timestamp);\\n        emit Heartbeat(msg.sender, 1, timestamp);\\n    }\\n\\n    function heartbeat() external {\\n        Garden storage garden = gardens[msg.sender];\\n        if (garden.state != GardenState.GROWING) revert GardenNotGrowing();\\n\\n        uint256 deadline = uint256(garden.lastHeartbeat) + inactivityWindow;\\n        if (block.timestamp > deadline) revert GardenExpired(deadline);\\n\\n        uint64 timestamp = uint64(block.timestamp);\\n        garden.heartbeatCount += 1;\\n        garden.lastHeartbeat = timestamp;\\n\\n        emit Heartbeat(msg.sender, garden.heartbeatCount, timestamp);\\n    }\\n\\n    function sealEternally(address owner) external {\\n        if (owner == address(0)) revert InvalidOwner();\\n\\n        Garden storage garden = gardens[owner];\\n        if (garden.state != GardenState.GROWING) revert GardenNotGrowing();\\n\\n        uint256 deadline = uint256(garden.lastHeartbeat) + inactivityWindow;\\n        if (block.timestamp <= deadline) revert GardenStillAlive(deadline);\\n\\n        uint64 timestamp = uint64(block.timestamp);\\n        garden.sealedAt = timestamp;\\n        garden.state = GardenState.ETERNAL;\\n\\n        emit GardenEternallySealed(owner, msg.sender, timestamp);\\n    }\\n\\n    function gardenOf(address owner) external view returns (Garden memory) {\\n        return gardens[owner];\\n    }\\n\\n    function deadlineOf(address owner) public view returns (uint256) {\\n        Garden storage garden = gardens[owner];\\n        if (garden.state == GardenState.NONE) return 0;\\n        return uint256(garden.lastHeartbeat) + inactivityWindow;\\n    }\\n\\n    function canSeal(address owner) external view returns (bool) {\\n        Garden storage garden = gardens[owner];\\n        return\\n            garden.state == GardenState.GROWING && block.timestamp > uint256(garden.lastHeartbeat) + inactivityWindow;\\n    }\\n}\\n\",\"keccak256\":\"0x965c1831a170ee08788e4b3306b25540df733d72000a2948b5d2c669c28b7628\",\"license\":\"MIT\"}},\"version\":1}",
